import:
    java.io.File
    java.util.Scanner
    java.io.PrintWriter

command getskript <string>:
    permission: op
    trigger:
        set {_skript} to new File("plugins/Skript/scripts/%arg-1%")
        set {_scanner} to new Scanner({_skript})
        set {_b} to written book
        set {_text} to ""
        while {_scanner}.hasNextLine():
            set {_text} to "%{_text}%%nl%%{_scanner}.nextLine()%"
            if mod(loop-iteration, 5) is 0:
                set page (loop-iteration / 5) of {_b} to {_text}
                set {_text} to ""
                wait 1 tick
                
        # try to give a writable book rather than a written one (WIP)                
        #set {_text::*} to compound list tag "pages" of compound tag "minecraft:written_book_content" of nbt compound of {_b}
        #set {_s} to writable book
        #set compound list tag "pages" of compound tag "minecraft:writable_book_content" of nbt compound of {_s} to {_text::*}
        #loop {_text::*}:
        #    set {_test} to loop-value
        #    regex replace "{extra:\[".*"\],.*:""""}" with ".*" in {_test}
        #    broadcast {_test}


        
        give player {_b}

on tab complete of "/getskript":
    loop "%new File("plugins/Skript/scripts/").listFiles()%" split at ",":
        set {_name} to loop-value
        regex replace "[\[\]]" with "" in {_name}
        replace all "plugins\Skript\scripts\" with "" in {_name}
        regex replace "^ *" with "" in {_name}
        if {_name} matches "^[-].*":
            continue
        if {_name} doesn't match ".*\.sk$":
            continue
        add {_name} to {_list::*}
    set tab completions for position 1 to {_list::*}


command saveskript <string>:
    permission: op
    trigger:
        set {_s} to "%page 1 of book player's tool%"
        loop amount of pages of player's tool times:
            set {_s} to "%{_s}%%page (loop-value + 1) of player's tool%"
            replace all "<none>" with "" in {_s}
        set {_file} to new File("plugins/Skript/scripts/%arg-1%")
        set {_writer} to new PrintWriter({_file})
        {_writer}.write({_s})
        {_writer}.close()

        reload script arg-1
